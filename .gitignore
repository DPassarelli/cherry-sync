# Compiled binary (matches the cmd/csync output)
/csync

# Config
/.csync.toml

# Go build artifacts
*.exe
*.test
*.out

# GoReleaser build output
/dist/

# Coverage
coverage.txt
coverage.html

# Reference docs (kept locally, not in repo)
*.pdf
*.png
*.zip

# Scratchpad for Claude
/.claude
/NOTES.md
/MOCKUP.md

# Release notes extracted from CHANGELOG.md by the release workflow (transient)
/.release-notes.md

# Code-signing material. These never belong in the repo — they live outside the
# working tree and in a password manager — but an accidental `git add .` is one
# keystroke away, so refuse them here as well.
*.p12
*.p8
*.key
*.cer
*.csr

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
